rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{document=**} {
      allow read: if true;
      allow create, update, delete: if false; // Replaced by users collection for PvP rating
    }
    match /users/{userId} {
      allow read: if true;
      // Allow users to create their own profile
      allow create: if request.auth != null && request.auth.uid == userId;
      // In a real app we'd secure rating updates strictly, but for this prototype allow authenticated users to update
      allow update: if request.auth != null; 
      allow delete: if false;
    }
    match /pvp_rooms/{document=**} {
      allow read, write: if true;
    }
  }
}
